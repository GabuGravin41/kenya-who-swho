{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "buildCommand": "pnpm --filter @kenya-elections/shared-types build && pnpm --filter @kenya-elections/database build && tsc"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm --filter @kenya-elections/shared-types build && pnpm --filter @kenya-elections/database build && tsc && vite build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
