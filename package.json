{
  "name": "kenya-who-swho-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @kenya-elections/web dev",
    "dev:api": "pnpm --filter @kenya-elections/api dev",
    "build": "pnpm --recursive run build",
    "postinstall": "pnpm --filter @kenya-elections/shared-types build && pnpm --filter @kenya-elections/database build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean"
  },

  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
